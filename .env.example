GROQ_API_KEY=
HF_TOKEN=
SUPADATA_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# The small model fits in ~0.5 GB RAM (Railway). Use -large only with 3+ GB of memory.
EMBED_MODEL=intfloat/multilingual-e5-small
RETRIEVER_K=4
FULL_CONTEXT_CHAR_LIMIT=24000
# Set to your Vercel URL when deployed (used for CORS).
FRONTEND_ORIGIN=http://localhost:3000
