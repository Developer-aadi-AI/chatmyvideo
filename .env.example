GROQ_API_KEY=
HF_TOKEN=
SUPADATA_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Background steps (section summaries, follow-up rewrites); has its own Groq rate limit.
LLM_FAST_MODEL=openai/gpt-oss-20b
# local = run an int8 copy of the model in-process (free, ~550 MB RAM);
# huggingface = HF Inference API (uses paid HF credits; HF_TOKEN needs the
# "Make calls to Inference Providers" permission).
EMBED_PROVIDER=local
EMBED_MODEL=intfloat/multilingual-e5-small
RETRIEVER_K=4
FULL_CONTEXT_CHAR_LIMIT=24000
# Set to your Vercel URL when deployed (used for CORS).
FRONTEND_ORIGIN=http://localhost:3000
